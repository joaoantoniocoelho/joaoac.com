---
// Each topic gets a small typographic illustration instead of a stock image: no extra requests, crisp at any size.
import type { PostData } from '../lib/posts.ts';

type Props = { topic: string; size?: 'small' | 'large'; cover?: PostData['cover'] };

const { topic, size = 'small', cover } = Astro.props;
const topicKind = topic === 'security' ? 'grid' : topic === 'ai' ? 'prompt' : 'lines';
const kind = cover ?? topicKind;
const mirrorBars = [
  { start: 30, width: 69, tone: 'ink' },
  { start: 48, width: 93, tone: 'ink' },
  { start: 66, width: 60, tone: 'soft' },
  { start: 66, width: 81, tone: 'accent' },
  { start: 48, width: 45, tone: 'ink' },
  { start: 30, width: 18, tone: 'ink' },
];
const HOUR_SIZE = 30;
const hourPosition = (column: number, row: number) => ({ x: 14 + column * 38, y: 28 + row * 38 });
const hours = Array.from({ length: 24 }, (_, hour) => hourPosition(hour % 6, Math.floor(hour / 6)));
const wantedHour = hourPosition(6, 1);
const overflowHours = [
  [6, 0],
  [6, 2],
  [6, 3],
  [7, 0],
  [7, 2],
  [7, 3],
  [8, 1],
  [8, 3],
  [9, 2],
].map(([column = 0, row = 0]) => hourPosition(column, row));
const columns = size === 'large' ? 14 : 10;
const cells = Array.from({ length: columns * 4 }, (_, index) => index);
const owned = columns + Math.floor(columns / 2) - 1;
---

<div class:list={['cover', `cover-${kind}`, `cover-${size}`]} aria-hidden="true">
  {kind === 'grid' && (
    <div class="grid" style={`--columns: ${columns}`}>
      {cells.map((cell) => (
        <span class:list={{ owned: cell === owned, probed: cell === owned + 1 }} />
      ))}
    </div>
  )}
  {kind === 'prompt' && (
    <span class="prompt">
      &gt;_
      <span class="caret" />
    </span>
  )}
  {kind === 'self-review' && (
    <svg class="mirror" viewBox="0 0 400 200" fill="none">
      <line class="mirror-axis" x1="200" y1="14" x2="200" y2="186" />
      {mirrorBars.map((bar, row) => (
        <g class={`tone-${bar.tone}`}>
          <rect x={bar.start} y={30 + row * 25} width={bar.width} height="8" rx="4" />
          <rect
            x={400 - bar.start - bar.width}
            y={30 + row * 25}
            width={bar.width}
            height="8"
            rx="4"
          />
        </g>
      ))}
    </svg>
  )}
  {kind === 'overflowing-hours' && (
    <svg class="hours" viewBox="0 0 400 200" fill="none">
      {hours.map(({ x, y }) => (
        <rect class="tone-ink" x={x} y={y} width={HOUR_SIZE} height={HOUR_SIZE} rx="5" />
      ))}
      <rect
        class="tone-accent"
        x={wantedHour.x}
        y={wantedHour.y}
        width={HOUR_SIZE}
        height={HOUR_SIZE}
        rx="5"
      />
      {overflowHours.map(({ x, y }) => (
        <rect class="hour-overflow" x={x} y={y} width={HOUR_SIZE} height={HOUR_SIZE} rx="5" />
      ))}
    </svg>
  )}
  {kind === 'lines' && (
    <div class="lines">
      <span style="width: 46%" />
      <span style="width: 62%; margin-left: 12%" />
      <span class="soft" style="width: 40%; margin-left: 24%" />
      <span class="soft" style="width: 54%; margin-left: 24%" />
      <span style="width: 30%; margin-left: 12%" />
      <span style="width: 12%" />
    </div>
  )}
</div>

<style>
  .cover {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .grid {
    width: 62%;
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: clamp(4px, 0.8vw, 8px);
  }

  .grid span {
    aspect-ratio: 1;
    border-radius: 4px;
    background: #dcdce1;
  }

  .grid .owned {
    background: var(--fg);
  }

  .grid .probed {
    background: none;
    border: 1.5px dashed var(--fg);
  }

  .prompt {
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--on-dark);
  }

  .caret {
    display: inline-block;
    width: 0.45em;
    height: 0.85em;
    margin-left: 0.1em;
    vertical-align: -0.1em;
    background: currentColor;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hour-overflow {
    stroke: var(--faint);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }

  .mirror,
  .hours {
    width: auto;
    height: 66%;
    max-width: 80%;
  }

  .mirror-axis {
    stroke: #3a3a3c;
    stroke-width: 2;
    stroke-dasharray: 2 8;
    stroke-linecap: round;
  }

  .tone-ink {
    fill: var(--on-dark);
  }

  .tone-soft {
    fill: var(--faint);
  }

  .tone-accent {
    fill: #fca052;
  }

  .lines {
    width: min(300px, 50%);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lines span {
    height: 5px;
    border-radius: 3px;
    background: var(--fg);
  }

  .lines .soft {
    background: var(--faint);
  }
</style>
