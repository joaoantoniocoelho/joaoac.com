---
import { getImage } from 'astro:assets';
import idle from '../assets/ichiro/ichiro-idle.png';
import blink from '../assets/ichiro/ichiro-blink.png';
import talking from '../assets/ichiro/ichiro-talking.png';
import thinking from '../assets/ichiro/ichiro-thinking.png';
import greeting from '../assets/ichiro/ichiro-greeting.png';
import sleeping from '../assets/ichiro/ichiro-sleeping.png';
import peeking from '../assets/ichiro/ichiro-peeking.png';
import { discoveryOrder, initialPrompts, prompts, promptsPtBr } from '../data/ichiro-prompts.ts';
import type { Mood } from '../lib/chat-data.ts';
import type { Locale } from '../lib/locale.ts';
import { CONTACT_EMAIL } from '../lib/site.ts';
import { ui } from '../lib/ui.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
const t = ui[locale].chat;

// Drawn at 96px wide on the dialog; twice that keeps the pixel art crisp on retina screens.
const SPRITE_WIDTH = 192;
const sprite = (src: typeof idle, width = SPRITE_WIDTH) =>
  getImage({ src, width, format: 'webp', quality: 90 });
const [idleImage, blinkImage, talkingImage, thinkingImage, greetingImage, sleepingImage] =
  await Promise.all([
    sprite(idle),
    sprite(blink),
    sprite(talking),
    sprite(thinking),
    sprite(greeting),
    sprite(sleeping),
  ]);
const moods: Record<Mood, string> = {
  idle: idleImage.src,
  blink: blinkImage.src,
  talking: talkingImage.src,
  thinking: thinkingImage.src,
  greeting: greetingImage.src,
  sleeping: sleepingImage.src,
};
const peekImage = await sprite(peeking, 144);

const chatData = {
  greeting: t.greeting,
  prompts: locale === 'pt-BR' ? promptsPtBr : prompts,
  initialPrompts,
  discoveryOrder,
  email: CONTACT_EMAIL,
  strings: {
    emailAnswer: t.emailAnswer,
    copyEmail: t.copyEmail,
    copied: t.copied,
    done: t.done,
    restart: t.restart,
    you: t.you,
  },
  moods,
};
---

<div class="ichiro" data-ichiro data-open="false">
  <section
    class="dialog"
    role="dialog"
    aria-labelledby="ichiro-name"
    tabindex="-1"
    hidden
    data-ichiro-panel
  >
    <img
      class="sprite"
      src={moods.idle}
      alt=""
      width="96"
      height="105"
      data-ichiro-mood
      data-mood="idle"
    />
    <div class="box">
      <header class="box-header">
        <p class="eyebrow who" id="ichiro-name">
          ichiro <span>· {t.status}</span>
        </p>
        <button type="button" class="icon-button" aria-label={t.reset} data-ichiro-reset>
          <svg
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M2.5 8a5.5 5.5 0 1 0 1.6-3.9M2.5 2.5v3h3"></path>
          </svg>
        </button>
        <button type="button" class="icon-button" aria-label={t.close} data-ichiro-close>
          <svg
            width="13"
            height="13"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M1 1l12 12M13 1L1 13"></path>
          </svg>
        </button>
      </header>
      <p class="asked" hidden data-ichiro-asked>
        <span class="asked-label">{t.you}:</span> <span data-ichiro-asked-text></span>
      </p>
      <p class="line" aria-hidden="true" title={t.skip}>
        <span data-ichiro-typed></span>
        <span class="rest" data-ichiro-rest></span>
      </p>
      <p class="visually-hidden" aria-live="polite" data-ichiro-live></p>
      <div class="answer-links" data-ichiro-links></div>
      <div class="choices" role="group" aria-label={t.suggested} data-ichiro-choices></div>
    </div>
  </section>

  <button
    type="button"
    class="peek"
    aria-label={t.open}
    aria-expanded="false"
    aria-haspopup="dialog"
    data-ichiro-launcher
  >
    <img src={peekImage.src} alt="" width="72" height="78" />
  </button>

  <script type="application/json" data-ichiro-data set:html={JSON.stringify(chatData)} />
</div>

<script>
  import { startIchiroChat } from '../scripts/ichiro-chat.ts';

  startIchiroChat();
</script>

<style>
  .ichiro {
    position: fixed;
    right: 0;
    bottom: 0;
    z-index: 50;
    pointer-events: none;
  }

  .ichiro > * {
    pointer-events: auto;
  }

  /* Ichiro peeks in from the right edge of the screen; hovering coaxes him out a little more. */
  .peek {
    position: fixed;
    right: 0;
    bottom: 32px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: transform 0.5s var(--ease-out);
    animation: peek-in 0.9s var(--ease-out) 1.2s both;
  }

  .peek img {
    display: block;
    width: 72px;
    height: auto;
    image-rendering: pixelated;
    filter: drop-shadow(0 10px 18px rgb(0 0 0 / 16%));
  }

  .peek:hover,
  .peek:focus-visible {
    transform: translateX(-6px) rotate(-4deg);
  }

  .peek:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
    border-radius: 12px;
  }

  [data-open='true'] .peek {
    transform: translateX(110%);
    pointer-events: none;
  }

  @keyframes peek-in {
    from {
      transform: translateX(110%);
    }
  }

  .dialog {
    position: fixed;
    right: 20px;
    bottom: 20px;
    width: min(460px, calc(100vw - 32px));
    /* Room above the box for ichiro to sit on its edge. */
    padding-top: 88px;
    outline: none;
    animation: dialog-in 0.45s var(--ease-out) both;
  }

  .dialog[hidden] {
    display: none;
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .sprite {
    position: absolute;
    top: 0;
    left: 22px;
    z-index: 1;
    width: 96px;
    height: 105px;
    object-fit: contain;
    object-position: bottom;
    image-rendering: pixelated;
    filter: drop-shadow(0 6px 8px rgb(0 0 0 / 18%));
  }

  .box {
    position: relative;
    max-height: calc(100dvh - 140px);
    overflow-y: auto;
    padding: 24px 22px 22px 24px;
    border-radius: var(--radius-tile);
    /* A faint edge keeps the box readable when it sits over one of the page's dark tiles. */
    border: 1px solid rgb(255 255 255 / 12%);
    background: var(--tile-dark);
    color: var(--on-dark);
    box-shadow: 0 30px 60px rgb(0 0 0 / 24%);
  }

  .box-header {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: -10px -12px 10px 0;
  }

  .who {
    flex: 1;
    min-width: 0;
    color: var(--on-dark);
  }

  .who span {
    color: var(--on-dark-muted);
    font-weight: 400;
  }

  .icon-button {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--on-dark-muted);
    cursor: pointer;
    transition:
      color 0.2s,
      background 0.2s;
  }

  .icon-button:hover {
    color: var(--on-dark);
    background: rgb(255 255 255 / 10%);
  }

  .asked {
    margin-bottom: 8px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--on-dark-muted);
  }

  .asked-label {
    font-weight: 600;
  }

  .line {
    min-height: 2.7em;
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1.4;
    letter-spacing: -0.005em;
    cursor: default;
  }

  .rest {
    visibility: hidden;
  }

  .answer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 18px;
  }

  .answer-links:not(:empty) {
    margin-top: 6px;
  }

  .ichiro :global(.answer-link) {
    color: var(--accent);
    font-size: 15px;
  }

  .ichiro :global(.done) {
    font-size: 14px;
    color: var(--on-dark-muted);
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .choices:not(:empty) {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid rgb(255 255 255 / 12%);
  }

  .ichiro :global(.choice) {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 6px 16px;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--on-dark);
    font-size: 14px;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
    animation: choice-in 0.4s var(--ease-out) both;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .ichiro :global(.choice:nth-child(2)) {
    animation-delay: 0.05s;
  }

  .ichiro :global(.choice:nth-child(3)) {
    animation-delay: 0.1s;
  }

  .ichiro :global(.choice:nth-child(4)) {
    animation-delay: 0.15s;
  }

  .ichiro :global(.choice:hover) {
    border-color: rgb(255 255 255 / 40%);
    background: rgb(255 255 255 / 8%);
  }

  @keyframes choice-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (max-width: 480px) {
    .dialog {
      right: 12px;
      bottom: 12px;
      width: calc(100vw - 24px);
      padding-top: 74px;
    }

    .sprite {
      width: 80px;
      height: 88px;
    }

    .line {
      font-size: 17px;
    }

    .peek {
      bottom: 20px;
    }

    .peek img {
      width: 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .peek {
      animation: none;
    }
  }
</style>
