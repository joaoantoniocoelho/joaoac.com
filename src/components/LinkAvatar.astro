---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
---

<div class="stage">
  <div class="card" data-tilt-card data-tilt-idle data-tilt-strength="0.7">
    <Image
      src={avatar}
      alt=""
      widths={[176, 352]}
      sizes="176px"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      class="portrait"
    />
    <span class="tilt-glare-clip" aria-hidden="true">
      <span class="tilt-glare" data-tilt-glare></span>
    </span>
  </div>
</div>

<style>
  .stage {
    width: 176px;
    aspect-ratio: 1;
    perspective: 900px;
  }

  .card {
    position: relative;
    width: 100%;
    height: 100%;
    /* Same proportion as the home card (40px on 460px), so the corners look identical at this size. */
    border-radius: 8.7%;
    overflow: hidden;
    background: #000000;
    box-shadow: 0 28px 60px rgb(0 0 0 / 22%);
    will-change: transform;
  }

  .card :global(.portrait) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }
</style>
