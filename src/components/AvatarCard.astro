---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import experiencesEn from '../data/experiences.en.json';
import experiencesPt from '../data/experiences.pt-BR.json';
import type { Locale } from '../lib/locale.ts';
import { ui } from '../lib/ui.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
const t = ui[locale].card;
const { experiences } = locale === 'pt-BR' ? experiencesPt : experiencesEn;
const [current] = experiences;

const facts = [
  { label: t.now, value: current ? `${current.title}, ${current.company.toLowerCase()}` : '' },
  { label: t.before, value: 'sap' },
  { label: t.writingAbout, value: t.writingAboutValue },
  { label: t.building, value: t.buildingValue },
].filter((fact) => fact.value);
---

<div class="card-stage rise" data-avatar-card>
  <div class="card" data-avatar-inner>
    <button
      type="button"
      class="face front"
      aria-label={t.flip}
      aria-expanded="false"
      data-avatar-flip
    >
      <Image
        src={avatar}
        alt=""
        widths={[460, 920]}
        sizes="(max-width: 600px) 100vw, 460px"
        format="webp"
        quality={88}
        loading="eager"
        fetchpriority="high"
        class="portrait mono"
      />
      <Image
        src={avatar}
        alt=""
        widths={[460, 920]}
        sizes="(max-width: 600px) 100vw, 460px"
        format="webp"
        quality={88}
        loading="eager"
        class="portrait color"
      />
      <span class="glare" aria-hidden="true"></span>
      <span class="plus" aria-hidden="true">
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <path d="M7 1v12M1 7h12"></path>
        </svg>
      </span>
    </button>

    <div class="face back" inert data-avatar-back>
      <span class="glare" aria-hidden="true"></span>
      <div class="back-content">
        <div class="identity">
          <Image src={avatar} alt="" width={104} height={104} format="webp" class="mini" />
          <span class="name">joão coelho</span>
          <button type="button" class="close" aria-label={t.flipBack} data-avatar-unflip>
            <svg
              width="13"
              height="13"
              viewBox="0 0 14 14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M1 1l12 12M13 1L1 13"></path>
            </svg>
          </button>
        </div>

        <div class="verse">
          <span class="verse-label">{t.verseLabel}</span>
          <p class="bio">{t.bio}</p>
        </div>

        <dl class="facts">
          {facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>

        <div class="links">
          <button
            type="button"
            class="primary copy-email"
            data-copy-email
            data-label={t.copyEmail}
            data-copied-label={t.emailCopied}
            data-failed-label={t.emailCopyFailed}
          >
            <svg
              class="copy-icon"
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <rect
                x="5"
                y="4"
                width="8"
                height="9"
                rx="1.5"
                stroke="currentColor"
                stroke-width="1.4"
              />
              <path
                d="M10.5 4V3.5A1.5 1.5 0 0 0 9 2H4.5A1.5 1.5 0 0 0 3 3.5V9a1.5 1.5 0 0 0 1.5 1.5H5"
                stroke="currentColor"
                stroke-width="1.4"
              />
            </svg>
            <svg
              class="check-icon"
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="m3 8 3.2 3.2L13 4.5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span data-email-copy-label>{t.copyEmail}</span>
          </button>
          <a href="https://linkedin.com/in/joaoac" rel="me">
            linkedin
          </a>
          <a href="https://github.com/joaoantoniocoelho" rel="me">
            github
          </a>
          <a href="https://x.com/joaoac_" rel="me">
            x
          </a>
        </div>
        <span class="visually-hidden" role="status" data-email-feedback></span>
      </div>
    </div>
  </div>
</div>
<p
  class="hint"
  aria-live="polite"
  data-hint-front={t.hintFront}
  data-hint-back={t.hintBack}
  data-avatar-hint
>
  {t.hintFront}
</p>

<script>
  import { startAvatarCard } from '../scripts/avatar-card.ts';

  startAvatarCard();
</script>

<style>
  .card-stage {
    --rotate-x: 0deg;
    --rotate-y: 0deg;
    --flip: 0deg;
    --glare-x: 50%;
    --glare-y: 50%;

    margin-top: 48px;
    width: min(460px, 100%);
    aspect-ratio: 1;
    perspective: 1600px;
    animation-delay: 0.34s;
  }

  .card {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rotate-x)) rotateY(calc(var(--rotate-y) + var(--flip)));
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .face {
    position: absolute;
    inset: 0;
    border-radius: 40px;
    overflow: hidden;
    background: #000000;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    box-shadow: 0 40px 90px rgb(0 0 0 / 20%);
  }

  .front {
    padding: 0;
    border: 0;
    cursor: pointer;
  }

  .front :global(.portrait) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .front :global(.mono) {
    filter: grayscale(1) contrast(1.08);
  }

  /* The color layer paints in from the top in steps, like rows of pixels filling in. */
  .front :global(.color) {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.3s steps(8);
  }

  .front:hover :global(.color),
  .front:focus-visible :global(.color) {
    clip-path: inset(0 0 0 0);
  }

  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--glare-x) var(--glare-y),
      rgb(255 255 255 / 22%),
      rgb(255 255 255 / 0%) 55%
    );
  }

  .plus {
    position: absolute;
    right: 22px;
    bottom: 22px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #ffffff;
    background: rgb(255 255 255 / 16%);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border: 1px solid rgb(255 255 255 / 22%);
  }

  .back {
    transform: rotateY(180deg);
    color: var(--on-dark);
    text-align: left;
  }

  .back .glare {
    opacity: 0.55;
  }

  .back-content {
    position: relative;
    height: 100%;
    overflow-y: auto;
    padding: clamp(22px, 7%, 44px);
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 4%, 26px);
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .identity :global(.mini) {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 50%;
    image-rendering: pixelated;
  }

  .name {
    flex: 1;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .close {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 18%);
    background: rgb(255 255 255 / 12%);
    color: #ffffff;
    cursor: pointer;
  }

  .verse {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .verse-label {
    color: var(--on-dark-muted);
    font-size: 13px;
  }

  .bio {
    font-family: var(--font-display);
    font-size: clamp(17px, 2.2vw, 21px);
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .facts {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
  }

  .facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    border-top: 1px solid rgb(255 255 255 / 12%);
  }

  .facts div:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 12%);
  }

  .facts dt {
    color: var(--on-dark-muted);
    flex-shrink: 0;
  }

  .facts dd {
    margin: 0;
    text-align: right;
  }

  .links {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .links a,
  .links button {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 12%);
    color: inherit;
    font-size: 14px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .links a:hover,
  .links button:hover {
    background: rgb(255 255 255 / 20%);
  }

  .links .primary {
    background: var(--on-dark);
    color: var(--fg);
    font-weight: 500;
  }

  .links .primary:hover {
    background: #e8e8ed;
  }

  .copy-email {
    gap: 7px;
  }

  .copy-email .check-icon {
    display: none;
  }

  .copy-email[data-state='copied'] {
    background: #e8e8ed;
  }

  .copy-email[data-state='copied'] .copy-icon {
    display: none;
  }

  .copy-email[data-state='copied'] .check-icon {
    display: block;
  }

  .copy-email[data-state='failed'] {
    color: var(--error);
  }

  .hint {
    margin-top: 22px;
    font-size: 12px;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
