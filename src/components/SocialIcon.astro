---
import type { SocialIconName } from '../lib/socials.ts';

type Props = { name: SocialIconName; size?: number; class?: string };

const { name, size = 22, class: className } = Astro.props;
// The X mark is drawn edge to edge, so it renders a touch smaller to look the same weight.
const px = name === 'x' ? Math.round(size * 0.9) : size;
const stroked = name === 'instagram' || name === 'email' || name === 'rss';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={px}
  height={px}
  fill={stroked ? 'none' : 'currentColor'}
  stroke={stroked ? 'currentColor' : undefined}
  stroke-width={stroked ? 1.7 : undefined}
  stroke-linecap={stroked ? 'round' : undefined}
  stroke-linejoin={stroked ? 'round' : undefined}
  aria-hidden="true"
>
  {name === 'x' && (
    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" />
    </>
  )}
  {name === 'linkedin' && (
    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
  )}
  {name === 'github' && (
    <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.72c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.38 9.38 0 0 1 12 6.84c.85 0 1.7.12 2.5.35 1.9-1.33 2.74-1.05 2.74-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.81c0 .27.18.6.69.49A10.25 10.25 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
  )}
  {name === 'email' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2.5" />
      <path d="m4 7.5 8 6 8-6" />
    </>
  )}
  {name === 'rss' && (
    <>
      <path d="M5 4.5a14.5 14.5 0 0 1 14.5 14.5" />
      <path d="M5 10.5a8.5 8.5 0 0 1 8.5 8.5" />
      <circle cx="6" cy="18" r="1.4" fill="currentColor" />
    </>
  )}
</svg>
