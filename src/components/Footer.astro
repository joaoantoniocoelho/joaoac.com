---
import SocialIcon from './SocialIcon.astro';
import type { Locale } from '../lib/locale.ts';
import { CONTACT_EMAIL } from '../lib/site.ts';
import { SOCIALS } from '../lib/socials.ts';
import { ui } from '../lib/ui.ts';

type Props = { locale: Locale };

const t = ui[Astro.props.locale];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <span>
      {t.footer.copyright} © {year} joão coelho.
    </span>
    <span class="links">
      {SOCIALS.map((social) => (
        <a href={social.href} rel="me" aria-label={social.label}>
          <SocialIcon name={social.icon} size={16} />
        </a>
      ))}
      <a href={`mailto:${CONTACT_EMAIL}`} aria-label={t.footer.email}>
        <SocialIcon name="email" size={16} />
      </a>
      <a href="/feed.xml" aria-label="rss">
        <SocialIcon name="rss" size={16} />
      </a>
    </span>
  </div>
</footer>

<style>
  .footer {
    margin-top: 120px;
    background: var(--tile);
    padding: 20px var(--gutter) 28px;
    display: flex;
    justify-content: center;
  }

  /* The home page ends on full tiles, which already read as a block, so they sit closer. */
  :global(main:has(> section.outside:last-of-type)) + .footer {
    margin-top: 48px;
  }

  .footer-inner {
    width: 100%;
    max-width: var(--page);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    /* Pulls the icons' hit areas out to the edge so the glyphs line up with the page. */
    margin-inline: -8px;
  }

  .links a {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    color: var(--fg-secondary);
    transition:
      color 0.2s,
      background 0.2s;
  }

  .links a:hover {
    color: var(--fg);
    background: rgb(0 0 0 / 5%);
  }
</style>
