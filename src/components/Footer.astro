---
import type { Locale } from '../lib/locale.ts';
import { CONTACT_EMAIL } from '../lib/site.ts';
import { ui } from '../lib/ui.ts';

type Props = { locale: Locale };

const t = ui[Astro.props.locale];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <span>
      {t.footer.copyright} © {year} joão coelho.
    </span>
    <span class="links">
      <a href={`mailto:${CONTACT_EMAIL}`}>{t.footer.email}</a>
      <a href="https://github.com/joaoantoniocoelho" rel="me">
        github
      </a>
      <a href="https://linkedin.com/in/joaoac" rel="me">
        linkedin
      </a>
      <a href="https://x.com/joaoac_" rel="me">
        x
      </a>
      <a href="/feed.xml">rss</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    margin-top: 120px;
    background: var(--tile);
    padding: 20px var(--gutter) 28px;
    display: flex;
    justify-content: center;
  }

  /* The home page ends on full tiles, which already read as a block, so they sit closer. */
  :global(main:has(> section.outside:last-of-type)) + .footer {
    margin-top: 48px;
  }

  .footer-inner {
    width: 100%;
    max-width: var(--page);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .links a {
    color: var(--fg-secondary);
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
