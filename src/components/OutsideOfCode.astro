---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { favoriteAlbums } from '../data/albums.ts';
import { readingLog } from '../data/bookshelf.ts';
import { favoriteFilms } from '../data/films.ts';
import { shelfFrom } from '../lib/bookshelf.ts';
import type { Locale } from '../lib/locale.ts';
import { ui } from '../lib/ui.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
const t = ui[locale].outside;

const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/books/*.{jpg,png,webp}', {
  eager: true,
});
const coverFor = (slug: string) =>
  Object.entries(covers).find(([path]) => path.split('/').pop()?.startsWith(`${slug}.`))?.[1]
    .default;

const books = shelfFrom(readingLog).map((book) => {
  const status =
    book.status === 'finished' && book.finishedIn
      ? `${t.status.finished} · ${book.finishedIn}`
      : t.status[book.status];
  return {
    ...book,
    title: book.title[locale],
    note: book.note?.[locale],
    statusLabel: status,
    cover: coverFor(book.slug),
  };
});
const hasNotes = books.some((book) => book.note);

const albumImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/albums/*.{jpg,png,webp}',
  { eager: true },
);
const albumImageFor = (slug: string, side: 'front' | 'back') =>
  Object.entries(albumImages).find(([path]) => path.endsWith(`/${slug}-${side}.jpg`))?.[1].default;
const albums = favoriteAlbums.map((album) => ({
  ...album,
  front: albumImageFor(album.slug, 'front'),
  back: albumImageFor(album.slug, 'back'),
}));

const filmImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/films/*.{jpg,png,webp}',
  { eager: true },
);
const filmImageFor = (slug: string) =>
  Object.entries(filmImages).find(([path]) => path.split('/').pop()?.startsWith(`${slug}.`))?.[1]
    .default;
const films = favoriteFilms.map((film) => ({
  ...film,
  title: film.title[locale],
  poster: filmImageFor(film.slug),
}));
---

<section class="page-wide outside" aria-labelledby="home-outside">
  <h2 class="section-title" id="home-outside">
    {t.title}
  </h2>
  <p class="subhead lead">{t.lead}</p>

  <section
    class="tile collection album-collection"
    aria-labelledby="favorite-albums"
    data-carousel-root
  >
    <div class="collection-head">
      <div>
        <h3 id="favorite-albums">{t.albumsTitle}</h3>
        <p>{t.albumsText}</p>
      </div>
      <div class="carousel-controls" data-carousel>
        <button type="button" aria-label={`${t.previous} ${t.albumsTitle}`} data-carousel-prev>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
            <path d="m14 5-7 7 7 7" />
          </svg>
        </button>
        <button type="button" aria-label={`${t.next} ${t.albumsTitle}`} data-carousel-next>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
            <path d="m10 5 7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
    <ol class="collection-track albums" tabindex="0" aria-label={t.albumsLabel} data-carousel-track>
      {albums.map((album) => {
        const backId = `album-back-${album.slug}`;
        return (
          <li class="album-item">
            <div class="media-stage" data-tilt-stage>
              <div class="album-flip" data-album-card>
                <button
                  type="button"
                  class="album-face album-front"
                  aria-label={`${album.title}, ${album.artist}. ${t.flipAlbum}`}
                  aria-expanded="false"
                  aria-controls={backId}
                  data-album-flip
                >
                  {album.front && (
                    <Image
                      src={album.front}
                      alt=""
                      widths={[240, 480, 640]}
                      sizes="(max-width: 640px) 220px, 320px"
                      format="webp"
                      loading="lazy"
                      class="album-image"
                    />
                  )}
                </button>
                <div class="album-face album-back" id={backId} inert data-album-back>
                  {album.back && (
                    <Image
                      src={album.back}
                      alt=""
                      widths={[600, 1200]}
                      sizes="(max-width: 640px) 220px, 320px"
                      format="webp"
                      loading="lazy"
                      class:list={['album-image', { 'back-left': album.slug === 'black-sabbath' }]}
                    />
                  )}
                  <button
                    type="button"
                    class="album-unflip"
                    aria-label={`${t.flipAlbumBack}: ${album.title}`}
                    data-album-unflip
                  ></button>
                  <div class="album-actions">
                    <span class="favorite-label">{t.favoriteTrack}</span>
                    <strong>{album.favoriteTrack.title}</strong>
                    <div class="album-links">
                      <a
                        href={album.favoriteTrack.spotifyUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${album.favoriteTrack.title} — Spotify`}
                      >
                        {t.playTrack}
                      </a>
                      <a
                        href={album.spotifyUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${album.title} — Spotify`}
                      >
                        {t.openAlbum}
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <span class="collection-item-title">{album.title}</span>
            <span class="collection-item-meta">{album.artist}</span>
          </li>
        );
      })}
    </ol>
  </section>

  <div class="tile-row collections">
    <div class="tile shelf compact-shelf" data-carousel-root>
      <div class="shelf-head">
        <div>
          <h3>{t.shelfTitle}</h3>
          {hasNotes && <span class="hint">{t.shelfHint}</span>}
        </div>
        <div class="carousel-controls" data-carousel>
          <button type="button" aria-label={`${t.previous} ${t.shelfTitle}`} data-carousel-prev>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
              <path d="m14 5-7 7 7 7" />
            </svg>
          </button>
          <button type="button" aria-label={`${t.next} ${t.shelfTitle}`} data-carousel-next>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
              <path d="m10 5 7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
      <ol class="books" tabindex="0" aria-label={t.shelfTitle} data-carousel-track>
        {books.map((book) => {
          const noteId = `book-note-${book.slug}`;
          const cover = book.cover ? (
            <Image
              src={book.cover}
              alt=""
              widths={[240, 480]}
              sizes="240px"
              format="webp"
              loading="lazy"
              class="cover-image"
            />
          ) : (
            <span class="cover-fallback">
              <span class="fallback-title">{book.title}</span>
              <span class="fallback-author">{book.author}</span>
            </span>
          );
          return (
            <li class="book">
              <div class="stage" data-tilt-stage>
                {book.note ? (
                  <div class="flip" data-book-card>
                    <button
                      type="button"
                      class="face front"
                      aria-label={`${book.title}, ${t.by} ${book.author}. ${book.statusLabel}. ${t.flip}`}
                      aria-expanded="false"
                      aria-controls={noteId}
                      data-book-flip
                    >
                      {cover}
                      <span class="badge" aria-hidden="true">
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M20 12a8 8 0 1 1-2.34-5.66" />
                          <path d="M20 4v4h-4" />
                        </svg>
                      </span>
                    </button>
                    <button
                      type="button"
                      class="face back"
                      id={noteId}
                      aria-label={`${book.title}. ${t.flipBack}`}
                      inert
                      data-book-back
                    >
                      <span class="back-head">
                        <span class="back-status">{book.statusLabel}</span>
                      </span>
                      <span class="back-title">{book.title}.</span>
                      <span class="back-author">{book.author}</span>
                      <span class="back-rule" aria-hidden="true" />
                      <span class="back-note">“{book.note}”</span>
                    </button>
                  </div>
                ) : (
                  <div class="static-cover">{cover}</div>
                )}
              </div>
              <span class="book-title">{book.title}</span>
              <span class="book-status">{book.statusLabel}</span>
            </li>
          );
        })}
      </ol>
    </div>

    <section class="tile collection" aria-labelledby="favorite-films" data-carousel-root>
      <div class="collection-head">
        <div>
          <h3 id="favorite-films">{t.filmsTitle}</h3>
          <p>{t.filmsText}</p>
        </div>
        <div class="carousel-controls" data-carousel>
          <button type="button" aria-label={`${t.previous} ${t.filmsTitle}`} data-carousel-prev>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
              <path d="m14 5-7 7 7 7" />
            </svg>
          </button>
          <button type="button" aria-label={`${t.next} ${t.filmsTitle}`} data-carousel-next>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
              <path d="m10 5 7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
      <ol class="collection-track films" tabindex="0" aria-label={t.filmsLabel} data-carousel-track>
        {films.map((film) => (
          <li class="film-item">
            <div class="media-stage" data-tilt-stage>
              <div class="film-poster">
                {film.poster && (
                  <Image
                    src={film.poster}
                    alt=""
                    widths={[200, 400]}
                    sizes="184px"
                    format="webp"
                    loading="lazy"
                    class="poster-image"
                  />
                )}
              </div>
            </div>
            <span class="collection-item-title">{film.title}</span>
            <span class="collection-item-meta">{film.year}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</section>

<script>
  import { startBookshelf } from '../scripts/bookshelf.ts';
  import { startAlbumCards } from '../scripts/album-cards.ts';
  import { startCarousels } from '../scripts/carousels.ts';
  import { startCoverTilt } from '../scripts/cover-tilt.ts';

  startBookshelf();
  startAlbumCards();
  startCarousels();
  startCoverTilt();
</script>

<style>
  .outside {
    padding-top: 96px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lead {
    margin: -16px auto 28px;
    text-align: center;
  }

  .shelf {
    padding: clamp(24px, 4vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .compact-shelf {
    flex: 1 1 calc(50% - 6px);
    min-width: 0;
    padding: 28px;
    gap: 8px;
  }

  .compact-shelf h3 {
    font-size: 22px;
  }

  .compact-shelf .shelf-head {
    min-height: 65px;
    align-items: flex-end;
    gap: 12px;
  }

  .compact-shelf .books {
    min-width: 0;
    padding: 14px 0 28px;
    display: flex;
    gap: 18px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .compact-shelf .books::-webkit-scrollbar {
    display: none;
  }

  .compact-shelf .book {
    flex: 0 0 var(--film-cover-width);
    scroll-snap-align: start;
  }

  .compact-shelf .stage {
    margin-bottom: 15px;
  }

  .compact-shelf .book-title {
    font-size: 15px;
    line-height: 1.25;
  }

  .compact-shelf .book-status {
    font-size: 13px;
    line-height: 1.25;
  }

  .compact-shelf .back {
    padding: 12px;
    gap: 2px;
  }

  .compact-shelf .back-head {
    margin: 0;
  }

  .compact-shelf .back-status,
  .compact-shelf .back-author {
    font-size: 11px;
  }

  .compact-shelf .back-title {
    font-size: 17px;
  }

  .compact-shelf .back-rule {
    margin: 3px 0;
  }

  .compact-shelf .back-note {
    font-size: 12.5px;
    line-height: 1.35;
  }

  .shelf-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
  }

  h3 {
    font-size: 28px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hint {
    font-size: 14px;
    color: var(--muted);
  }

  .books {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }

  .stage,
  .media-stage {
    --rotate-x: 0deg;
    --rotate-y: 0deg;
    --flip: 0deg;
    --glare-x: 50%;
    --glare-y: 50%;
    --lift: 0px;

    position: relative;
    isolation: isolate;
    width: 100%;
    margin-bottom: 18px;
    perspective: 950px;
    perspective-origin: center 40%;
  }

  .stage {
    max-width: 240px;
  }

  .stage::after,
  .media-stage::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 10%;
    right: 10%;
    bottom: -13px;
    height: 18px;
    border-radius: 50%;
    background: rgb(0 0 0 / 35%);
    filter: blur(11px);
    transition:
      transform 350ms ease,
      filter 350ms ease,
      opacity 350ms ease;
  }

  .flip,
  .static-cover {
    position: relative;
    aspect-ratio: 2 / 3;
  }

  .flip,
  .album-flip,
  .static-cover,
  .film-poster {
    transform: translateY(var(--lift)) rotateX(var(--rotate-x))
      rotateY(calc(var(--rotate-y) + var(--flip)));
    transition: transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .flip,
  .album-flip {
    transform-style: preserve-3d;
  }

  .flip.is-flipped,
  .album-flip.is-flipped {
    --flip: 180deg;
  }

  .face,
  .static-cover {
    border-radius: 4px 8px 8px 4px;
    overflow: hidden;
    box-shadow:
      2px 2px 0 #e7e3da,
      5px 5px 0 #b9b4a9,
      9px 13px 17px -10px rgb(0 0 0 / 48%),
      17px 23px 28px -17px rgb(0 0 0 / 42%);
  }

  .face {
    position: absolute;
    inset: 0;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .front::before,
  .back::before,
  .static-cover::before,
  .album-face::before,
  .film-poster::before {
    content: '';
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle at var(--glare-x) var(--glare-y),
      rgb(255 255 255 / 28%),
      rgb(255 255 255 / 0%) 55%
    );
    transition: opacity 200ms ease;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .stage:hover,
    .media-stage:hover {
      --lift: -6px;
    }

    .stage:hover::after,
    .media-stage:hover::after {
      transform: scale(0.88) translateY(6px);
      filter: blur(15px);
      opacity: 0.7;
    }

    .stage:hover .front::before,
    .stage:hover .back::before,
    .stage:hover .static-cover::before,
    .media-stage:hover .album-face::before,
    .media-stage:hover .film-poster::before {
      opacity: 1;
    }
  }

  .front {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* A soft crease along the spine so flat cover images read as books. */
  .front::after,
  .static-cover::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 10px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 22%),
      rgb(255 255 255 / 0%) 40%,
      rgb(0 0 0 / 18%) 70%,
      rgb(0 0 0 / 0%)
    );
  }

  .book :global(.cover-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-fallback {
    width: 100%;
    height: 100%;
    padding: 18% 12% 12%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    background: var(--fg);
    color: var(--on-dark);
    text-align: center;
  }

  .fallback-title {
    font-family: var(--font-display);
    font-size: clamp(17px, 2vw, 24px);
    line-height: 1.1;
    font-weight: 600;
  }

  .fallback-author {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--on-dark-muted);
  }

  .badge {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #ffffff;
    background: rgb(0 0 0 / 35%);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid rgb(255 255 255 / 22%);
  }

  .back {
    transform: rotateY(180deg);
    padding: clamp(16px, 9%, 24px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    border: 0;
    background: var(--tile-dark);
    color: var(--on-dark);
    font: inherit;
    text-align: left;
    border-radius: 8px 4px 4px 8px;
    cursor: pointer;
    box-shadow:
      3px 3px 0 #35312e,
      6px 7px 0 #aaa49c,
      14px 22px 23px -14px rgb(0 0 0 / 50%);
  }

  .back-head {
    display: flex;
    align-items: center;
    margin-bottom: 4px;
  }

  .back-status,
  .back-author {
    font-size: 13px;
    color: var(--on-dark-muted);
  }

  .back-title {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.9vw, 22px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .back-rule {
    height: 1px;
    margin: 10px 0;
    background: rgb(255 255 255 / 14%);
  }

  .back-note {
    font-size: 15px;
    line-height: 1.45;
  }

  /* The note settles in line by line once the cover has turned. */
  .back > :not(.back-head) {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s,
      transform 0.6s var(--ease-out);
  }

  .is-flipped .back > :not(.back-head) {
    opacity: 1;
    transform: none;
    transition-delay: 0.35s;
  }

  .is-flipped .back > .back-rule,
  .is-flipped .back > .back-note {
    transition-delay: 0.45s;
  }

  .book-title {
    font-size: 15px;
    font-weight: 600;
  }

  .book-status {
    font-size: 14px;
    color: var(--muted);
  }

  .collections {
    --film-cover-width: clamp(180px, 17vw, 184px);

    align-items: stretch;
  }

  .collection {
    flex: 1 1 calc(50% - 6px);
    min-width: 0;
    padding: 28px 0 20px;
    display: flex;
    flex-direction: column;
  }

  .album-collection {
    --album-cover-width: clamp(220px, 27vw, 320px);
  }

  .album-collection .collection-track {
    width: 100%;
    max-width: 1000px;
    margin-inline: auto;
    gap: 32px;
  }

  .collection-head {
    min-height: 65px;
    padding: 0 28px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .collection h3 {
    font-size: 22px;
  }

  .collection-head p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 14px;
  }

  .carousel-controls {
    flex-shrink: 0;
    display: flex;
    gap: 6px;
  }

  .carousel-controls button {
    width: 34px;
    height: 34px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .carousel-controls button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .carousel-controls button:not(:disabled):hover {
    background: rgb(0 0 0 / 6%);
  }

  .carousel-controls svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .collection-track {
    min-width: 0;
    margin: 8px 0 0;
    padding: 14px 28px 28px;
    display: flex;
    gap: 18px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-padding-inline: 28px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
  }

  .collection-track::-webkit-scrollbar {
    display: none;
  }

  .collection-track li {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    scroll-snap-align: start;
  }

  .album-item {
    width: var(--album-cover-width);
  }

  .film-item {
    width: var(--film-cover-width);
  }

  .media-stage {
    margin-bottom: 15px;
  }

  .album-flip {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .album-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 3px;
    padding: 0;
    background: #151515;
    box-shadow:
      3px 3px 0 #262422,
      6px 6px 0 #aaa69e,
      13px 18px 18px -11px rgb(0 0 0 / 48%),
      20px 27px 30px -18px rgb(0 0 0 / 38%);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .album-front {
    cursor: pointer;
  }

  .album-back {
    color: #ffffff;
    transform: rotateY(180deg);
  }

  .album-front :global(.album-image),
  .album-back :global(.album-image),
  .film-poster :global(.poster-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
