---
import Base from '../layouts/Base.astro';
import experiencesEn from '../data/experiences.en.json';
import experiencesPt from '../data/experiences.pt-BR.json';
import type { Locale } from '../lib/locale.ts';
import { CONTACT_EMAIL } from '../lib/site.ts';
import { ui } from '../lib/ui.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
const t = ui[locale].about;
const { experiences } = locale === 'pt-BR' ? experiencesPt : experiencesEn;
---

<Base
  locale={locale}
  path="/experiences"
  title={ui[locale].nav.about}
  description={t.metaDescription}
>
  <section class="hero">
    <h1 class="display">{t.title}</h1>
    <p class="intro">{t.intro}</p>
  </section>

  <section class="page journey" aria-labelledby="journey">
    <h2 id="journey">{t.journey}</h2>
    <ol>
      {experiences.map((experience) => (
        <li>
          <span class="period">{experience.period}</span>
          <div class="role">
            {experience.companyUrl ? (
              <a
                class="company underline-hover"
                href={experience.companyUrl}
                rel="noopener noreferrer"
              >
                {experience.company}
              </a>
            ) : (
              <span class="company">{experience.company}</span>
            )}
            <span class="title">{experience.title}</span>
            <ul>
              {experience.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <p class="technologies">{experience.technologies.join(' · ')}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="page contact" aria-labelledby="contact">
    <h2 id="contact">{t.contact}</h2>
    <p class="contact-text">{t.contactText}</p>
    <div class="links">
      <a class="pill-soft" href="https://linkedin.com/in/joaoac" rel="me">
        linkedin
      </a>
      <a class="pill-soft" href="https://github.com/joaoantoniocoelho" rel="me">
        github
      </a>
      <a class="pill-soft" href="https://x.com/joaoac_" rel="me">
        x
      </a>
      <a class="pill-soft" href="https://instagram.com/joaoac_dev" rel="me">
        instagram
      </a>
      <button
        type="button"
        class="pill-soft"
        data-copy-url={CONTACT_EMAIL}
        data-copied-label={t.emailCopied}
      >
        {t.copyEmail}
      </button>
    </div>
  </section>
</Base>

<script>
  import { startCopyButtons } from '../scripts/copy-buttons.ts';

  startCopyButtons();
</script>

<style>
  .intro {
    max-width: 640px;
    margin-top: 32px;
    font-size: clamp(19px, 1.8vw, 21px);
    line-height: 1.5;
  }

  .journey {
    padding-top: 104px;
  }

  h2 {
    margin-bottom: 32px;
    font-size: 36px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  ol > li {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 40px;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }

  .period {
    flex: 0 0 200px;
    padding-top: 6px;
    font-size: 14px;
    color: var(--muted);
  }

  .role {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .company {
    align-self: flex-start;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .title {
    color: var(--muted);
  }

  .role ul {
    margin: 10px 0 0;
    padding-left: 20px;
    line-height: 1.5;
  }

  .role ul li + li {
    margin-top: 8px;
  }

  .technologies {
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }

  .contact {
    padding-top: 96px;
  }

  .contact-text {
    margin: -16px 0 24px;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
