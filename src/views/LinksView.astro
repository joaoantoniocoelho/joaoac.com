---
import Base from '../layouts/Base.astro';
import LinkAvatar from '../components/LinkAvatar.astro';
import { localizedPath, type Locale } from '../lib/locale.ts';
import { CONTACT_EMAIL } from '../lib/site.ts';
import { ui } from '../lib/ui.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
const t = ui[locale].links;
const otherLocale: Locale = locale === 'en' ? 'pt-BR' : 'en';

const github = 'https://github.com/joaoantoniocoelho';
const linkedin = 'https://linkedin.com/in/joaoac';
const email = `mailto:${CONTACT_EMAIL}`;
---

<Base locale={locale} path="/links" title="links" description={t.metaDescription} minimal>
  <section class="links-page">
    <LinkAvatar />
    <h1>joão coelho.</h1>
    <p class="tagline">{t.tagline}</p>

    <div class="buttons">
      <a class="pill" href={localizedPath('/', locale)}>
        {t.site}
      </a>
      <a class="pill outline" href={localizedPath('/projects', locale)}>
        {t.projects}
      </a>
    </div>

    <ul class="socials" aria-label={t.social}>
      <li>
        <a href={github} rel="me" aria-label={t.github}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.72c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.38 9.38 0 0 1 12 6.84c.85 0 1.7.12 2.5.35 1.9-1.33 2.74-1.05 2.74-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.81c0 .27.18.6.69.49A10.25 10.25 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"></path>
          </svg>
        </a>
      </li>
      <li>
        <a href={linkedin} rel="me" aria-label={t.linkedin}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path>
          </svg>
        </a>
      </li>
      <li>
        <a href={email} aria-label={t.email}>
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
            <path d="m4 7.5 8 6 8-6"></path>
          </svg>
        </a>
      </li>
    </ul>

    <a
      class="language"
      href={localizedPath('/links', otherLocale)}
      hreflang={otherLocale}
      lang={otherLocale}
    >
      {ui[locale].switchLanguage}
    </a>
  </section>
</Base>

<style>
  .links-page {
    width: 100%;
    max-width: 400px;
    margin-inline: auto;
    padding: 64px var(--gutter) 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    margin-top: 36px;
    font-size: clamp(36px, 9vw, 44px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .tagline {
    margin-top: 10px;
    font-size: 19px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--muted);
  }

  .buttons {
    margin-top: 36px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .buttons .pill {
    min-height: 52px;
  }

  .pill.outline {
    background: transparent;
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background 0.25s;
  }

  .pill.outline:hover {
    background: var(--tile);
  }

  .socials {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 8px;
  }

  .socials a {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--muted);
    transition:
      color 0.2s,
      background 0.2s;
  }

  .socials a:hover {
    color: var(--fg);
    background: var(--tile);
  }

  .language {
    margin-top: 36px;
    padding: 12px;
    font-size: 12px;
    color: var(--faint);
  }

  .language:hover {
    text-decoration: underline;
  }
</style>
