---
import Base from '../layouts/Base.astro';
import LinkAvatar from '../components/LinkAvatar.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { postsFor } from '../lib/content.ts';
import { localizedPath, type Locale } from '../lib/locale.ts';
import { CONTACT_EMAIL } from '../lib/site.ts';
import { SOCIALS } from '../lib/socials.ts';
import { ui } from '../lib/ui.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
const t = ui[locale].links;
const about = ui[locale].about;
const otherLocale: Locale = locale === 'en' ? 'pt-BR' : 'en';

const identity = `${t.areas} · ${t.place}`;

const [latestPost] = await postsFor(locale);
type Card = { title: string; text: string; href: string };
const cards: Card[] = [
  { title: t.site, text: t.siteText, href: localizedPath('/', locale) },
  {
    title: t.writing,
    text: latestPost ? `${t.latest}: ${latestPost.title}` : '',
    href: localizedPath('/blog', locale),
  },
  { title: t.projects, text: t.projectsText, href: localizedPath('/projects', locale) },
];
---

<Base locale={locale} path="/links" title="links" description={t.metaDescription} minimal>
  <section class="links-page">
    <LinkAvatar />
    <h1>joão coelho.</h1>
    <p class="identity">{identity}</p>

    <ul class="cards">
      {cards.map((card) => (
        <li>
          <a class="card" href={card.href}>
            <span class="card-text">
              <span class="card-title">{card.title}</span>
              {card.text && <span class="card-desc">{card.text}</span>}
            </span>
            <span class="card-arrow" aria-hidden="true">
              ›
            </span>
          </a>
        </li>
      ))}
    </ul>

    <ul class="socials" aria-label={t.social}>
      {SOCIALS.map((social) => (
        <li>
          <a href={social.href} rel="me" aria-label={social.label}>
            <SocialIcon name={social.icon} />
          </a>
        </li>
      ))}
      <li>
        <a href={`mailto:${CONTACT_EMAIL}`} aria-label={t.email}>
          <SocialIcon name="email" />
        </a>
      </li>
    </ul>

    <div class="contact">
      <h2>{t.contactTitle}</h2>
      <p>{about.contactText}</p>
      <button
        type="button"
        class="pill-soft copy-email"
        data-copy-email
        data-label={about.copyEmail}
        data-copied-label={about.emailCopied}
        data-failed-label={ui[locale].card.emailCopyFailed}
      >
        <span data-email-copy-label>{about.copyEmail}</span>
      </button>
      <span class="visually-hidden" role="status" data-email-feedback></span>
    </div>

    <a
      class="language"
      href={localizedPath('/links', otherLocale)}
      hreflang={otherLocale}
      lang={otherLocale}
    >
      {ui[locale].switchLanguage}
    </a>
  </section>
</Base>

<script>
  import { startLinkContact } from '../scripts/link-contact.ts';

  startLinkContact();
</script>

<style>
  .links-page {
    width: 100%;
    max-width: 400px;
    margin-inline: auto;
    padding: 64px var(--gutter) 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    margin-top: 36px;
    font-size: clamp(36px, 9vw, 44px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .identity {
    margin-top: 10px;
    font-size: 15px;
    color: var(--fg-secondary);
  }

  .cards,
  .socials {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cards {
    margin-top: 32px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card {
    min-height: 64px;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-radius: 20px;
    background: var(--tile);
    text-align: left;
    transition:
      background 0.2s,
      transform 0.7s var(--ease-out);
  }

  .card:hover {
    background: #e8e8ed;
    transform: scale(1.012);
  }

  .card-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 17px;
    font-weight: 600;
  }

  .card-desc {
    font-size: 14px;
    line-height: 1.35;
    color: var(--muted);
  }

  .card-arrow {
    flex-shrink: 0;
    font-size: 18px;
    color: var(--faint);
  }

  .socials {
    margin-top: 24px;
    display: flex;
    gap: 6px;
  }

  .socials a {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    color: var(--muted);
    transition:
      color 0.2s,
      background 0.2s;
  }

  .socials a:hover {
    color: var(--fg);
    background: var(--tile);
  }

  .contact {
    margin-top: 32px;
    padding-top: 28px;
    width: 100%;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .contact h2 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .contact p {
    margin-bottom: 10px;
    font-size: 15px;
    color: var(--muted);
  }

  .copy-email[data-state='failed'] {
    color: var(--error);
  }

  .language {
    margin-top: 28px;
    padding: 12px;
    font-size: 12px;
    color: var(--faint);
  }

  .language:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: background 0.2s;
    }

    .card:hover {
      transform: none;
    }
  }
</style>
