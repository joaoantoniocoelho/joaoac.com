---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects.ts';
import type { Locale } from '../lib/locale.ts';
import { ui } from '../lib/ui.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
const t = ui[locale].projects;
const RANKED_BARS = [92, 80, 72, 61, 52, 43, 34, 25];
const STAGES = [28, 52, 76, 100];
const ANSWER_LINES = [100, 88, 94, 56];
---

<Base
  locale={locale}
  path="/projects"
  title={ui[locale].nav.projects}
  description={t.metaDescription}
>
  <section class="hero">
    <h1 class="display">{t.title}</h1>
  </section>

  <div class="page-wide list">
    {projects.map((project, index) => {
      const dark = index % 2 === 1;
      const live = project.status === 'live';
      return (
        <section
          class:list={['project', index === 0 ? 'lead' : 'compact']}
          id={project.slug}
          aria-labelledby={`${project.slug}-title`}
        >
          <div class:list={['tile', 'showcase', { 'tile-dark': dark }]}>
            <span class="eyebrow">{live ? t.live : t.comingSoon}</span>
            <h2 id={`${project.slug}-title`}>{project.name}</h2>
            <p class="one-liner">{project.oneLiner[locale]}</p>
            <div class="actions">
              <a class="pill" href={project.url}>
                {t.visit}
              </a>
            </div>
            {project.slug === 'tech-digest' && (
              <div class="bars" aria-hidden="true">
                {RANKED_BARS.map((width, bar) => (
                  <span style={`width: ${width}%; animation-delay: ${bar * 0.2}s`} />
                ))}
              </div>
            )}
            {project.slug === 'alturo' && (
              <div class="stages" aria-hidden="true">
                {STAGES.map((height, stage) => (
                  <span
                    class={`stage-${stage}`}
                    style={`height: ${height}%; animation-delay: ${stage * 0.25}s`}
                  />
                ))}
              </div>
            )}
            {project.slug === 'porque' && (
              <div class="flip" aria-hidden="true">
                <div class="flip-card">
                  <span class="face front">
                    <svg viewBox="0 0 100 100" aria-hidden="true">
                      <path
                        d="M30 36C30 20 42 11 53 11C66 11 75 20 75 32C75 45 64 50 57 55C52 59 50 63 50 69"
                        fill="none"
                        stroke="#000"
                        stroke-width="12"
                        stroke-linecap="round"
                      />
                      <circle cx="50" cy="87" r="8" fill="#f2b705" />
                    </svg>
                  </span>
                  <span class="face back">
                    {ANSWER_LINES.map((width) => (
                      <i style={`width: ${width}%`} />
                    ))}
                  </span>
                </div>
              </div>
            )}
          </div>
        </section>
      );
    })}
  </div>
</Base>

<style>
  .list {
    padding-top: 56px;
    display: flex;
    flex-direction: column;
    gap: 88px;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-margin-top: 24px;
  }

  .project > .showcase {
    flex: 1;
  }

  /* Animations sit at the bottom of the card, so a stretched card grows empty space above them. */
  .bars,
  .stages,
  .flip {
    margin-top: auto;
  }

  .compact .stages {
    height: 160px;
  }

  .compact .flip {
    padding-top: 28px;
  }

  .compact .flip-card {
    height: 150px;
  }

  .compact .front svg {
    height: 84px;
  }

  .compact .back {
    padding: 30px 28px;
  }

  @media (min-width: 900px) {
    .list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 12px;
      row-gap: 12px;
    }

    .lead {
      grid-row: span 2;
    }
  }

  .showcase {
    padding: 48px 24px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h2 {
    margin-top: 8px;
    font-size: clamp(40px, 4vw, 48px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .one-liner {
    margin-top: 12px;
    max-width: 620px;
    font-size: 19px;
    line-height: 1.35;
  }

  .showcase .actions {
    margin-top: 24px;
  }

  .tile-dark .pill {
    background: var(--on-dark);
    color: var(--fg);
  }

  .bars {
    margin-top: 44px;
    width: min(620px, 100%);
    padding: 40px 40px 44px;
    border-radius: 24px 24px 0 0;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bars span {
    height: 8px;
    border-radius: 4px;
    background: var(--fg);
    animation: pulse 3.2s ease-in-out infinite;
  }

  .stages {
    margin-top: 44px;
    width: min(520px, 100%);
    height: 260px;
    padding: 0 40px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    align-items: end;
  }

  .stages span {
    border-radius: 14px 14px 0 0;
    transform-origin: bottom;
    animation: grow 2.6s cubic-bezier(0.65, 0, 0.35, 1) infinite alternate;
  }

  .stage-0 {
    border: 1px solid var(--fg-secondary);
    border-bottom: 0;
  }

  .stage-1 {
    border: 1px solid var(--faint);
    border-bottom: 0;
  }

  .stage-2 {
    background: var(--fg-secondary);
  }

  .stage-3 {
    background: var(--on-dark);
  }

  .flip {
    margin-top: 44px;
    width: min(620px, 100%);
    padding: 40px 0 0;
    perspective: 900px;
    display: flex;
    justify-content: center;
  }

  .flip-card {
    position: relative;
    width: min(320px, 80%);
    height: 220px;
    transform-style: preserve-3d;
    animation: flip 6s var(--ease-out) infinite;
  }

  .face {
    position: absolute;
    inset: 0;
    border-radius: 24px 24px 0 0;
    background: var(--bg);
    backface-visibility: hidden;
  }

  .front {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .front svg {
    height: 110px;
  }

  .back {
    transform: rotateY(180deg);
    padding: 44px 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .back i {
    height: 8px;
    border-radius: 4px;
    background: var(--fg);
  }

  @keyframes flip {
    0%,
    35% {
      transform: rotateY(0deg);
    }
    50%,
    85% {
      transform: rotateY(180deg);
    }
    100% {
      transform: rotateY(360deg);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0.4);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>
