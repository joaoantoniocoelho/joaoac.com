---
import '../styles/global.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-soft-normal.woff2?url';
import plexLatin from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import IchiroChat from '../components/IchiroChat.astro';
import { pathForLocale, type Locale } from '../lib/locale.ts';
import { absoluteUrl, languageAlternates, ogLocale, pageTitle } from '../lib/seo.ts';
import { CONTACT_EMAIL, SITE_AUTHOR, SITE_NAME, SITE_URL } from '../lib/site.ts';
import { SOCIALS } from '../lib/socials.ts';

type Props = {
  locale: Locale;
  // Path of the English version of this page; the Portuguese one is derived from it.
  path: string;
  title: string;
  description: string;
  ogType?: 'website' | 'profile' | 'article';
  article?: { publishedTime: string; modifiedTime: string; tags: string[] };
  noindex?: boolean;
  // Standalone pages (like /links) drop the site chrome: nav, footer and the Ichiro chat.
  minimal?: boolean;
  jsonLd?: Record<string, unknown>;
};

const {
  locale,
  path,
  title,
  description,
  ogType = 'website',
  article,
  noindex,
  minimal = false,
  jsonLd,
} = Astro.props;
const canonical = absoluteUrl(pathForLocale(path, locale));
const og = ogLocale(locale);
const fullTitle = pageTitle(title);
const ogImage = absoluteUrl('/og.png');
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: SITE_AUTHOR,
      alternateName: SITE_NAME,
      jobTitle: 'Senior Software Engineer',
      worksFor: { '@type': 'Organization', name: 'ADP' },
      url: SITE_URL,
      image: `${SITE_URL}/avatar.png`,
      email: CONTACT_EMAIL,
      sameAs: SOCIALS.map((social) => social.href),
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'PUCRS' },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'porto alegre',
        addressRegion: 'RS',
        addressCountry: 'BR',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: SITE_NAME,
      author: { '@id': `${SITE_URL}/#person` },
      inLanguage: ['en-US', 'pt-BR'],
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {[plexLatin, frauncesLatin].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
    ))}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languageAlternates(path).map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/feed.xml" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="author" content={SITE_AUTHOR} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={og.locale} />
    <meta property="og:locale:alternate" content={og.alternate} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        <meta property="article:modified_time" content={article.modifiedTime} />
        <meta property="article:author" content={SITE_AUTHOR} />
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@joaoac_dev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Runs before first paint so Portuguese readers never see the English page flash. An explicit
        pick from a language switch wins over the browser's languages; /pt-BR URLs and noindex pages
        (the 404) are never redirected, so shared links and crawlers keep landing where they point. */}
    <script is:inline>
      (() => {
        const key = 'locale';
        let saved = null;
        try {
          saved = localStorage.getItem(key);
        } catch {}
        document.addEventListener('click', (event) => {
          const link = event.target instanceof Element && event.target.closest('a[hreflang]');
          if (!link) return;
          try {
            localStorage.setItem(key, link.hreflang);
          } catch {}
        });
        const path = location.pathname;
        if (path === '/pt-BR' || path.startsWith('/pt-BR/')) return;
        if (document.querySelector('meta[name="robots"][content~="noindex"]')) return;
        const languages = navigator.languages?.length ? navigator.languages : [navigator.language];
        const detected = languages.find((lang) => /^(pt|en)\b/i.test(lang)) ?? 'en';
        const wantsPt = saved ? saved === 'pt-BR' : /^pt/i.test(detected);
        if (!wantsPt) return;
        location.replace(`/pt-BR${path === '/' ? '' : path}${location.search}${location.hash}`);
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {analyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </head>
  <body>
    {!minimal && <Nav locale={locale} path={path} />}
    <main>
      <slot />
    </main>
    {!minimal && <Footer locale={locale} />}
    {!minimal && <IchiroChat locale={locale} />}
  </body>
</html>
