{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porque-landing",
  "compatibility_date": "2026-10-01",
  // Static pages are served straight from the edge; only /api/* runs the Worker script.
  "main": "./src/worker/index.ts",
  "routes": [{ "pattern": "porque.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Secrets (RESEND_API_KEY) are set with `wrangler secret put`, never here.
  "vars": {
    "RESEND_SEGMENT_ID": "d78cac12-ddbc-48a6-a340-4bf516997c38",
  },
}
