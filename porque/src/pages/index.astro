---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import Mark from '../components/Mark.astro';
import Phone from '../components/Phone.astro';
import Widgets from '../components/Widgets.astro';
import Dots from '../components/Dots.astro';
import { splitHighlight } from '../lib/highlight.ts';
import { PLANS, formatBRL, perMonthCents, yearlyDiscountPercent } from '../lib/pricing.ts';
import { APP_STORE_URL, AUTHOR_URL, META_DESCRIPTION, PAGE_TITLE } from '../lib/site.ts';

const steps = [
  [
    'no seu horário',
    'uma pergunta te encontra.',
    'Receba a pergunta do dia no horário que você escolher.',
  ],
  [
    'seu palpite',
    'qual é o seu palpite?',
    'Escolha uma resposta antes de descobrir. Ou vá direto à explicação.',
  ],
  [
    'um minuto',
    'entenda o porquê.',
    'Leia uma explicação curta e ilustrada. Saia com algo novo para pensar — e contar por aí.',
  ],
] as const;

const body = [
  {
    text: 'Fotografe a Lua perto do horizonte e depois no alto do céu. Nas duas fotos, ela ocupa o mesmo espaço. O que muda é a forma como você interpreta a distância.',
    hi: '',
  },
  {
    text: 'Perto do horizonte, há prédios, árvores e morros entre você e a Lua. Esse cenário faz o cérebro concluir que ela está muito longe, e ele compensa aumentando o tamanho que você percebe.',
    hi: 'o cérebro concluir que ela está muito longe',
  },
  {
    text: 'No alto do céu, sem nada para comparar, essa correção não acontece. O efeito intriga gente desde Ptolomeu, e até hoje não existe uma explicação única aceita por todos.',
    hi: '',
  },
].map((p) => ({ ...p, parts: splitHighlight(p.text, p.hi) }));

const facts = [
  ['o nome disso', 'ilusão da Lua'],
  ['intriga desde', 'Ptolomeu, século II'],
  ['faça o teste', 'olhe por um rolo de papel'],
];

// The three signs of progress in the app. Everything is stored on the iPhone, nothing is graded.
const guessOptions = [
  ['a', 'a atmosfera funciona como uma lente de aumento.', false],
  ['b', 'o cérebro interpreta o horizonte como mais distante.', true],
  ['c', 'a Lua está fisicamente mais perto da Terra no horizonte.', false],
] as const;

// Last seven days, oldest first: read, forgiven rest, today.
const streakDays = ['lido', 'lido', 'descanso', 'lido', 'lido', 'lido', 'hoje'] as const;
const streakLabels = ['s', 'd', 's', 't', 'q', 'q', 's'] as const;

const principles = [
  [
    'uma pausa que vale a pena.',
    'Uma leitura curta para entender algo que antes passava despercebido.',
    false,
  ],
  [
    'um aviso, no seu horário.',
    'Você escolhe quando receber a pergunta do dia. Os lembretes de sequência ficam de fora.',
    false,
  ],
  [
    'sem anúncios no caminho.',
    'A assinatura dá acesso às descobertas e ao acervo. Sua leitura segue sem interrupções de anúncios.',
    true,
  ],
] as const;

// 3x3 glyph per theme: which dots are lit.
const themes = [
  ['ciência', 'como as coisas funcionam.', '010111010'],
  ['natureza', 'o planeta, os bichos, o tempo lá fora.', '101010111'],
  ['mente', 'por que pensamos e sentimos assim.', '111101111'],
  ['tecnologia', 'o que existe por trás das telas.', '101111101'],
  ['história', 'a origem do que parece óbvio.', '110011100'],
  ['cotidiano', 'o mistério das coisas pequenas.', '000010000'],
] as const;

const { anual, mensal } = PLANS;
const discount = yearlyDiscountPercent(anual.cents, mensal.cents);

const faq = [
  [
    'posso conhecer antes de assinar?',
    'Sim. O app apresenta uma descoberta completa antes da assinatura: você pode dar um palpite, ler a explicação e conhecer a experiência. Para continuar, escolha um dos planos.',
  ],
  [
    'posso cancelar quando quiser?',
    'Sim, pelos Ajustes do iPhone. Ao cancelar, você desativa a próxima renovação da assinatura.',
  ],
  [
    'posso ler as perguntas anteriores?',
    'Sim. Elas ficam no acervo, organizadas por tema, para você explorar quando quiser.',
  ],
  [
    'quando chega a pergunta do dia?',
    'O horário inicial é às 7h, mas você pode escolher outro e mudar depois nas configurações.',
  ],
  [
    'preciso dar um palpite?',
    'Não. Você pode escolher uma das três respostas ou pular direto para a explicação.',
  ],
  [
    'como funcionam os dias de curiosidade?',
    'Cada dia de leitura conta para sua sequência. Você pode ficar um dia sem ler por semana sem interrompê-la. Se ficar dois, a contagem recomeça.',
  ],
  [
    'tem widget?',
    'Sim. Há widgets para a tela de início e a tela bloqueada. Eles mostram a pergunta do dia e, depois da leitura, a resposta curta.',
  ],
];
---

<Base title={PAGE_TITLE} description={META_DESCRIPTION}>
  <header class="wrap top">
    <a href="/" aria-label="por quê?">
      <Wordmark />
    </a>
    <div class="top-actions">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="alternar tema claro e escuro"
      >
        <svg
          class="sun"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"></path>
        </svg>
        <svg
          class="moon"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
        </svg>
      </button>
      <a class="pill pill-ghost" href="#preco">
        planos
      </a>
    </div>
  </header>

  <main>
    <section class="wrap hero">
      <div>
        <p class="eyebrow">app para iPhone</p>
        <h1 class="display-font">
          uma pergunta por dia<span class="pt">.</span>
        </h1>
        <p class="sub">para quem nunca para de perguntar.</p>
        <p class="lede">
          Descubra o porquê das coisas em explicações curtas, ilustradas e fáceis de entender. Um
          minuto de leitura para sair com algo novo na cabeça.
        </p>
        <div class="actions">
          {APP_STORE_URL ? (
            <>
              <a class="pill" href={APP_STORE_URL}>
                baixar na App Store
              </a>
              <a class="pill pill-ghost" href="#descoberta">
                ler uma descoberta
              </a>
            </>
          ) : (
            <>
              <a class="pill" href="#descoberta">
                ler uma descoberta
              </a>
              <span class="status">em breve na App Store</span>
            </>
          )}
        </div>
        <p class="hint">
          comece pela pergunta <span class="hint-wide">ao lado</span>
          <span class="hint-narrow">abaixo</span>.
        </p>
      </div>
      <Phone />
    </section>

    <section class="sec" id="como-funciona">
      <div class="wrap">
        <div class="sec-h">
          <h2 class="display-font">
            da pergunta à descoberta<span class="pt">.</span>
          </h2>
          <p>Um convite para olhar o mundo com mais curiosidade, todos os dias.</p>
        </div>
        <div class="steps">
          {steps.map(([k, title, text]) => (
            <div class="step">
              <span class="k mono">{k}</span>
              <div>
                <b>
                  {title.slice(0, -1)}
                  <span class="pt">.</span>
                </b>
                <span>{text}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec" id="descoberta">
      <div class="wrap read">
        <div class="sec-h" style="margin-bottom:0">
          <h2 class="display-font">
            um minuto de leitura. uma descoberta para levar<span class="pt">.</span>
          </h2>
          <p>
            Cada pergunta vem com uma resposta direta e uma explicação ilustrada. Para você entender
            o porquê e lembrar depois.
          </p>
        </div>
        <article class="article">
          <p class="eyebrow">nº 296 · ciência · 1 min</p>
          <h3 class="rq display-font">por que a Lua parece maior no horizonte?</h3>
          <p class="lead display-font">Ela não cresce. Quem exagera é o seu cérebro.</p>
          <figure class="fig">
            <Dots />
            <figcaption>as duas luas do desenho têm exatamente o mesmo tamanho.</figcaption>
          </figure>
          {body.map(({ parts }) => (
            <p class="bp">
              {parts.before}
              {parts.mark && <span class="hl">{parts.mark}</span>}
              {parts.after}
            </p>
          ))}
          <div class="keep">
            <h4>
              para guardar<span class="pt">.</span>
            </h4>
            <dl>
              {facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>
      </div>
    </section>

    <section class="sec" id="widgets">
      <div class="wrap widgets">
        <div class="sec-h" style="margin-bottom:0">
          <h2 class="display-font">
            a curiosidade começa na tela de início<span class="pt">.</span>
          </h2>
          <p>
            Deixe a pergunta do dia à vista com o widget. Quando bater a curiosidade, toque para
            descobrir. Depois da leitura, a resposta fica ali para você lembrar.
          </p>
        </div>
        <Widgets />
      </div>
    </section>

    <section class="sec" id="progresso">
      <div class="wrap">
        <div class="sec-h">
          <h2 class="display-font">
            cada descoberta conta<span class="pt">.</span>
          </h2>
          <p>
            Dê seus palpites, acompanhe seus dias de leitura e veja os temas que mais despertam sua
            curiosidade.
          </p>
        </div>
        <div class="progress">
          <article class="pcard">
            <div
              class="pviz"
              role="img"
              aria-label="três palpites, com o segundo marcado como certo"
            >
              <ul class="guess">
                {guessOptions.map(([letter, text, right]) => (
                  <li class:list={{ right }}>
                    <span class="gl">{right ? '✓' : letter}</span>
                    <span>{text}</span>
                  </li>
                ))}
              </ul>
            </div>
            <h3 class="display-font">
              um palpite antes da resposta<span class="pt">.</span>
            </h3>
            <p>
              Será que você já sabe? Escolha entre três respostas e descubra. Se preferir, pule
              direto para a explicação.
            </p>
          </article>
          <article class="pcard">
            <div
              class="pviz"
              role="img"
              aria-label="seis dias de curiosidade, com um dia de descanso"
            >
              <p class="big mono">6</p>
              <p class="cap">dias de curiosidade</p>
              <div class="week">
                {streakDays.map((day, i) => (
                  <div>
                    <span class={`rd ${day}`}></span>
                    <small>{streakLabels[i]}</small>
                  </div>
                ))}
              </div>
            </div>
            <h3 class="display-font">
              um hábito do seu jeito<span class="pt">.</span>
            </h3>
            <p>
              Veja seus dias de curiosidade se acumularem, uma leitura de cada vez. Um pequeno
              espaço para aprender na sua rotina.
            </p>
          </article>
          <article class="pcard">
            <div class="pviz" role="img" aria-label="progresso de leitura em três temas">
              <ul class="tprog">
                {(
                  [
                    ['mente', '111101111', 5, 9],
                    ['ciência', '010111010', 3, 9],
                    ['história', '110011100', 4, 8],
                  ] as const
                ).map(([name, pattern, read, total]) => (
                  <li>
                    <svg class="glyph" viewBox="0 0 30 30" aria-hidden="true">
                      {[...pattern].map((on, i) => (
                        <circle
                          cx={5 + (i % 3) * 10}
                          cy={5 + Math.floor(i / 3) * 10}
                          r={on === '1' ? 3.6 : 2}
                          class={on === '1' ? '' : 'off'}
                        />
                      ))}
                    </svg>
                    <div>
                      <p class="tn display-font">{name}</p>
                      <span class="bar">
                        <i style={`width:${Math.round((read / total) * 100)}%`} />
                      </span>
                    </div>
                    <span class="tc mono">
                      {read}/{total}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <h3 class="display-font">
              siga sua curiosidade<span class="pt">.</span>
            </h3>
            <p>
              Explore o acervo por tema, encontre perguntas que ainda não leu e revisite suas
              descobertas favoritas.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="sec" id="principios">
      <div class="wrap">
        <div class="sec-h">
          <h2 class="display-font">
            feito para caber no seu dia<span class="pt">.</span>
          </h2>
        </div>
        <div class="principles">
          {principles.map(([title, text, dark]) => (
            <div class:list={['principle', { dark }]}>
              <h3 class="display-font">
                {title.slice(0, -1)}
                <span class="pt">.</span>
              </h3>
              <p>{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec" id="temas">
      <div class="wrap">
        <div class="sec-h">
          <h2 class="display-font">o que desperta sua curiosidade?</h2>
          <p>
            Do que acontece na sua cabeça à origem dos nossos costumes: explore seis temas e
            encontre sua próxima pergunta.
          </p>
        </div>
        <ul class="themes">
          {themes.map(([nome, desc, pattern]) => (
            <li>
              <svg class="glyph" viewBox="0 0 30 30" aria-hidden="true">
                {[...pattern].map((on, i) => (
                  <circle
                    cx={5 + (i % 3) * 10}
                    cy={5 + Math.floor(i / 3) * 10}
                    r={on === '1' ? 3.6 : 2}
                    class={on === '1' ? '' : 'off'}
                  />
                ))}
              </svg>
              <div>
                <p class="tn display-font">{nome}</p>
                <p class="td">{desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sec" id="preco">
      <div class="wrap">
        <div class="sec-h">
          <h2 class="display-font">
            alimente sua curiosidade todos os dias<span class="pt">.</span>
          </h2>
          <p>
            Uma nova pergunta por dia, explicações ilustradas e acesso ao acervo para explorar
            quando quiser. Tudo sem anúncios.
          </p>
        </div>
        <div class="plans">
          <div class="plan main">
            <p class="name">anual</p>
            <p class="price display-font">
              {formatBRL(anual.cents)} <span class="unit">por ano</span>
            </p>
            <p class="per">
              equivale a {formatBRL(perMonthCents(anual.cents))} por mês · cobrado anualmente
            </p>
            <p class="tag">economize {discount}% em relação ao mensal</p>
          </div>
          <div class="plan">
            <p class="name">mensal</p>
            <p class="price display-font">
              {formatBRL(mensal.cents)} <span class="unit">por mês</span>
            </p>
            <p class="per">cobrado mensalmente</p>
          </div>
        </div>
        <p class="fine">
          Assinatura com renovação automática. Cancele quando quiser nos Ajustes do iPhone.
        </p>
      </div>
    </section>

    <section class="sec" id="perguntas">
      <div class="wrap">
        <div class="sec-h">
          <h2 class="display-font">ficou alguma pergunta?</h2>
        </div>
        <div class="faq">
          {faq.map(([q, a]) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="wrap closing">
      <Mark size="56px" />
      <h2 class="display-font">
        uma pergunta por dia<span class="pt">.</span>
      </h2>
      <p class="sub">para quem nunca para de perguntar.</p>
      <p class="lede">
        Leve sua curiosidade com você.
        <br />A próxima descoberta cabe em um minuto.
      </p>
      {APP_STORE_URL ? (
        <a class="pill" href={APP_STORE_URL}>
          baixar na App Store
        </a>
      ) : (
        <span class="status">em breve na App Store</span>
      )}
    </section>
  </main>

  <footer class="wrap foot">
    <span>
      feito por <a href={AUTHOR_URL}>joão coelho</a>
    </span>
    <span class="foot-links">
      <a href="/suporte">suporte</a>
      <a href="/privacidade">privacidade</a>
    </span>
  </footer>

  <script>
    import '../scripts/page.ts';
  </script>
</Base>
