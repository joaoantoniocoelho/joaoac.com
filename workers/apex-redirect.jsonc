{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "joaoac-apex-redirect",
  "main": "apex-redirect.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "joaoac.com", "custom_domain": true },
    { "pattern": "www.digest.joaoac.com", "custom_domain": true },
  ],
}
