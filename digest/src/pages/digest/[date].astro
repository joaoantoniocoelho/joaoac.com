---
import { env } from 'cloudflare:workers';
import Edition from '../../views/Edition.astro';
import { edgeCacheHeaders, NO_STORE } from '../../lib/cache-headers.ts';
import { editionTag } from '../../lib/revalidate.ts';
import { editionRoute } from '../../lib/routes.ts';

const result = await editionRoute(env.DIGEST_API_URL, Astro.params.date);
if (result.kind === 'missing' || result.kind === 'redirect') return Astro.rewrite('/404');
if (result.kind === 'unavailable') {
  return new Response('tech digest is unavailable right now.', {
    status: 503,
    headers: { 'Cache-Control': NO_STORE, 'Retry-After': '300' },
  });
}
for (const [name, value] of Object.entries(edgeCacheHeaders([editionTag(result.value.date)]))) {
  Astro.response.headers.set(name, value);
}
---

<Edition locale="en" edition={result.value} />
