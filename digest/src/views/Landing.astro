---
import DigestLayout from '../layouts/DigestLayout.astro';
import Countdown from '../components/Countdown.astro';
import SignupForm from '../components/SignupForm.astro';
import { copy, type Locale } from '../lib/copy.ts';
import { archivePath, editionPath, formatEditionDate } from '../lib/digest-routes.ts';
import { safeArticleUrl, type PublicEdition } from '../lib/editions.ts';

type Props = { locale: Locale; latestEdition: PublicEdition | null };

const { locale, latestEdition } = Astro.props;
const t = copy[locale];

const sampleArticles = [
  {
    title: 'Formal methods with Hillel Wayne',
    url: 'https://newsletter.pragmaticengineer.com/p/formal-methods-with-hillel-wayne',
  },
  {
    title: 'The last six months in LLMs, in five minutes',
    url: 'https://simonw.substack.com/p/the-last-six-months-in-llms-in-five',
  },
  { title: 'What changed in SQLite this year', url: 'https://sqlite.org/changes.html' },
];

const preview = latestEdition
  ? {
      stamp: latestEdition.date.slice(8),
      date: formatEditionDate(locale, latestEdition.date),
      count: t.articleCount(latestEdition.articles.length),
      note: t.latestIntro,
      articles: latestEdition.articles.slice(0, 3).map((article) => ({
        title: article.title,
        url: safeArticleUrl(article.url),
        meta: [article.source, ...article.topics].join(' · '),
      })),
    }
  : {
      stamp: t.sampleStamp,
      date: t.sampleEditionDate,
      count: t.sampleEditionCount,
      note: t.sampleIntro,
      articles: sampleArticles.map((article, index) => ({
        title: article.title,
        url: article.url,
        meta: t.sampleArticleMeta[index] ?? '',
      })),
    };

const [answerFirst, answerSecond] = t.answerTitle.split(/(?<=\.)\s/);
---

<DigestLayout locale={locale} paths={{ en: '/', 'pt-BR': '/pt-BR' }}>
  <section class="hero" id="subscribe">
    <h1 class="headline rise">{t.title}.</h1>
    <p class="lead rise">
      {t.detail} <span>{t.heroNote}</span>
    </p>
    <div class="rise form-wrap">
      <SignupForm locale={locale} inputId="digest-email" />
      <p class="fine-print">{t.privacy}</p>
    </div>
    {latestEdition && (
      <div class="actions rise">
        <a class="chevron-link" href={editionPath(locale, latestEdition.date)}>
          {t.readLatestEdition}
        </a>
        <a class="chevron-link" href={archivePath(locale)}>
          {t.browseArchive}
        </a>
      </div>
    )}

    <div class="mail rise" aria-label={t.sampleLabel}>
      <div class="mail-sheet">
        <div class="mail-head">
          <div class="mail-title">
            <span class="mail-brand">tech digest</span>
            <span class="mail-heading">{t.sampleEditionTitle}</span>
            <span class="mail-date">
              {preview.date} · {preview.count}
            </span>
          </div>
          <span class="stamp" aria-hidden="true">
            {preview.stamp}
          </span>
        </div>
        <ol class="mail-list">
          {preview.articles.map((article, index) => (
            <li>
              <span class="number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                {article.url ? (
                  <a
                    class="article-title underline-hover"
                    href={article.url}
                    rel="noopener noreferrer"
                  >
                    {article.title}
                  </a>
                ) : (
                  <span class="article-title">{article.title}</span>
                )}
                <span class="article-meta">{article.meta}</span>
              </div>
            </li>
          ))}
        </ol>
        <span class="mail-foot">
          {t.sampleCurated} · {t.sampleWebsite} · {t.sampleUnsubscribe}
        </span>
      </div>
    </div>
    <p class="mail-note">{preview.note}</p>
  </section>

  <div class="page-wide block">
    <Countdown locale={locale} />
  </div>

  <section class="page-wide block" aria-labelledby="pain">
    <h2 class="section-title narrow-title" id="pain">
      {t.painTitle}.
    </h2>
    <div class="tile-row three">
      {t.painItems.map((item) => (
        <article class="tile card">
          <span class="card-number" aria-hidden="true">
            {item.number}
          </span>
          <h3>{item.title}.</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="hero statement">
    <h2>
      {answerFirst}
      <br />
      <span>{answerSecond}</span>
    </h2>
    <p>{t.answerDescription}</p>
  </section>

  <section class="page-wide block" aria-labelledby="process">
    <h2 class="section-title" id="process">
      {t.processTitle}.
    </h2>
    <ol class="tile-row three steps">
      {t.steps.map((step, index) => (
        <li class="tile card">
          <span class="step" aria-hidden="true">
            {index + 1}
          </span>
          <h3>{step.title}.</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="hero final" aria-labelledby="final">
    <p class="kicker">{t.finalLabel}</p>
    <h2 id="final">{t.finalTitle}</h2>
    <p class="final-text">{t.finalDescription}</p>
    <div class="form-wrap">
      <SignupForm locale={locale} inputId="digest-email-final" action={t.finalAction} />
    </div>
  </section>
</DigestLayout>

<style>
  .kicker {
    font-size: 21px;
    font-weight: 600;
    color: var(--muted);
  }

  .headline {
    margin-top: 10px;
    max-width: 920px;
    font-size: clamp(44px, 7.4vw, 96px);
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -0.015em;
    animation-delay: 0.08s;
  }

  .lead {
    margin-top: 20px;
    max-width: 640px;
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: -0.015em;
    animation-delay: 0.16s;
  }

  .lead span {
    color: var(--muted);
  }

  .form-wrap {
    margin-top: 36px;
    width: min(480px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    animation-delay: 0.24s;
  }

  .fine-print {
    font-size: 14px;
    color: var(--muted);
  }

  .hero .actions {
    margin-top: 8px;
  }

  .mail {
    margin-top: 72px;
    width: min(880px, 100%);
    padding: clamp(20px, 6vw, 64px) clamp(16px, 6vw, 64px) 0;
    border-radius: 40px;
    background: var(--tile);
    animation-delay: 0.34s;
  }

  .mail-sheet {
    padding: 40px clamp(20px, 5vw, 48px) 32px;
    border-radius: 24px 24px 0 0;
    background: #ffffff;
    box-shadow: 0 30px 80px rgb(0 0 0 / 8%);
    text-align: left;
    display: flex;
    flex-direction: column;
  }

  .mail-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .mail-title {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mail-brand {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  .mail-heading {
    font-size: 28px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .mail-date {
    font-size: 14px;
    color: var(--muted);
  }

  .stamp {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: var(--fg);
    color: #ffffff;
    display: grid;
    place-items: center;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.1;
  }

  .mail-list {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .mail-list li {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 12px;
    padding: 18px 0;
    border-top: 1px solid #e5e5ea;
  }

  .mail-list li:last-child {
    border-bottom: 1px solid #e5e5ea;
  }

  .mail-list div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .number {
    padding-top: 2px;
    font-size: 13px;
    color: var(--faint);
  }

  .article-title {
    font-size: 18px;
    font-weight: 600;
  }

  .article-meta {
    font-size: 13px;
    color: var(--muted);
  }

  .mail-foot {
    margin-top: 20px;
    font-size: 12px;
    color: var(--faint);
  }

  .mail-note {
    margin-top: 16px;
    max-width: 560px;
    font-size: 12px;
    color: var(--muted);
  }

  .block {
    padding-top: 120px;
  }

  .narrow-title {
    max-width: 820px;
    margin-inline: auto;
  }

  .three > * {
    flex-basis: 300px;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    padding: 40px 32px 44px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-number {
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--line);
  }

  .step {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--fg);
    color: #ffffff;
    display: grid;
    place-items: center;
    font-size: 15px;
    font-weight: 600;
  }

  h3 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .card p {
    line-height: 1.45;
    color: var(--fg-secondary);
  }

  .statement {
    padding-top: 160px;
  }

  .statement h2,
  .final h2 {
    max-width: 900px;
    font-size: clamp(40px, 7vw, 80px);
    line-height: 1.03;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .statement h2 span {
    color: var(--faint);
  }

  .statement p {
    margin-top: 24px;
    max-width: 560px;
    font-size: 21px;
    line-height: 1.4;
    color: var(--fg-secondary);
  }

  .final {
    padding-top: 160px;
  }

  .final h2 {
    margin-top: 10px;
  }

  .final-text {
    margin-top: 16px;
    font-size: 21px;
    color: var(--fg-secondary);
  }
</style>
